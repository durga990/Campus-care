PORT=5000
NODE_ENV=development
# Local: mongodb://127.0.0.1:27017/campuscare  | Atlas: mongodb+srv://<user>:<pass>@<cluster>/campuscare
MONGO_URI=
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Frontend origin allowed by CORS (Vite default below)
CLIENT_URL=http://localhost:5173
